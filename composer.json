{
    "name": "cpcmomentum/contractmanager",
    "description": "Nextcloud App zur Vertragsverwaltung mit Kündigungserinnerungen",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "cpcMomentum GmbH"
        }
    ],
    "require": {
        "php": "^8.2",
        "smalot/pdfparser": "^2.10",
        "tecnickcom/tcpdf": "^6.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "nextcloud/ocp": "^32.0 || ^33.0 || ^34.0",
        "symfony/console": "^6.0 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\ContractManager\\": "lib/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "vendor/nextcloud/ocp/OCP"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "strip-tcpdf-fonts": [
            "find vendor/tecnickcom/tcpdf/fonts -mindepth 1 -maxdepth 1 ! -name 'freesans.*' ! -name 'freesansb.*' ! -name 'helvetica*.php' ! -name 'freefont-20120503' -exec rm -rf {} +",
            "find vendor/tecnickcom/tcpdf/fonts/freefont-20120503 -type f ! -name AUTHORS ! -name COPYING ! -name README -delete"
        ],
        "post-install-cmd": [
            "@strip-tcpdf-fonts"
        ],
        "post-update-cmd": [
            "@strip-tcpdf-fonts"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
