{
  "name": "contractmanager",
  "version": "1.2.6",
  "description": "Nextcloud App zur Vertragsverwaltung mit Kündigungserinnerungen",
  "main": "src/main.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build && mkdir -p js css && cp -r dist/js/* js/ && cp -r dist/css/* css/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --ext .js,.ts,.vue src",
    "lint:l10n": "node scripts/check-l10n.mjs",
    "lint:fix": "eslint --ext .js,.ts,.vue src --fix",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cpcMomentum/contractmanager.git"
  },
  "keywords": [
    "nextcloud",
    "app",
    "contracts",
    "management"
  ],
  "author": "cpcMomentum GmbH",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@nextcloud/auth": "^2.5.3",
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/dialogs": "^7.4.0",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.1.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.5.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-material-design-icons": "^5.3.0"
  },
  "devDependencies": {
    "@nextcloud/eslint-config": "^8.4.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^8.57.0",
    "happy-dom": "^20.9.0",
    "sass": "^1.70.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.4",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.0"
  }
}
