{
    "name": "contractmanager",
    "version": "1.8.0",
    "description": "Nextcloud App zur Vertragsverwaltung mit Kündigungserinnerungen",
    "main": "src/main.ts",
    "scripts": {
        "dev": "vite",
        "build": "vite build && mkdir -p js css && cp -r dist/js/* js/ && cp -r dist/css/* css/",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint --ext .js,.ts,.vue src",
        "l10n:check": "nc-l10n-check",
        "l10n:fix": "nc-l10n-check --fix",
        "lint:fix": "eslint --ext .js,.ts,.vue src --fix",
        "prepare": "git config core.hooksPath .githooks || true"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/cpcMomentum/contractmanager.git"
    },
    "keywords": [
        "nextcloud",
        "app",
        "contracts",
        "management"
    ],
    "author": "cpcMomentum GmbH",
    "license": "AGPL-3.0-or-later",
    "dependencies": {
        "@nextcloud/auth": "^2.5.3",
        "@nextcloud/axios": "^2.5.0",
        "@nextcloud/dialogs": "^7.5.0",
        "@nextcloud/initial-state": "^2.2.0",
        "@nextcloud/l10n": "^3.1.0",
        "@nextcloud/router": "^3.2.0",
        "@nextcloud/vue": "^9.13.0",
        "pinia": "^2.3.1",
        "vue": "^3.5.43",
        "vue-material-design-icons": "^5.3.0"
    },
    "devDependencies": {
        "@nextcloud/eslint-config": "^8.4.1",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^8.57.0",
        "happy-dom": "^20.14.5",
        "nc-app-tooling": "github:cpcMomentum/nc-app-tooling#v1.15.0",
        "sass": "^1.104.1",
        "typescript": "^5.7.2",
        "vite": "^7.1.3",
        "vitest": "^4.1.11",
        "vue-tsc": "^2.2.0"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "overrides": {
        "fast-xml-parser": "^5.7.0"
    }
}
