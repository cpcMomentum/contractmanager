# Dependencies
node_modules/

# Composer: vendor/ ist per Default ignoriert, aber die REINEN Runtime-Pakete
# (composer install --no-dev) werden getrackt und ausgeliefert — genau wie das
# kompilierte css/. Grund: git-basiertes Packen (git archive) liesse ein
# ungetracktes vendor/ ausfallen, und dann ist die PDF-Textextraktion
# (smalot/pdfparser) im Release kaputt (#245 / #249). Dev-Deps (phpunit,
# nextcloud/ocp) bleiben ignoriert — sie tauchen nur bei `composer install`
# OHNE --no-dev auf und duerfen nicht in Git/Tarball landen.
vendor/*
!vendor/autoload.php
!vendor/composer
!vendor/smalot
!vendor/symfony
vendor/symfony/*
!vendor/symfony/polyfill-mbstring
# TCPDF: nur freesans, freesansb und die helvetica-Metriken werden ausgeliefert
!vendor/tecnickcom
vendor/tecnickcom/tcpdf/fonts/*
!vendor/tecnickcom/tcpdf/fonts/freesans.*
!vendor/tecnickcom/tcpdf/fonts/freesansb.*
!vendor/tecnickcom/tcpdf/fonts/helvetica*.php
!vendor/tecnickcom/tcpdf/fonts/freefont-20120503
vendor/tecnickcom/tcpdf/fonts/freefont-20120503/*
!vendor/tecnickcom/tcpdf/fonts/freefont-20120503/AUTHORS
!vendor/tecnickcom/tcpdf/fonts/freefont-20120503/COPYING
!vendor/tecnickcom/tcpdf/fonts/freefont-20120503/README

# Build output (js/ UND das kompilierte css/ werden committet für einfache Installation
# und robuste Releases: git-basiertes Packen liesse ungetrackte Dateien aus, ein
# Release ohne dieses CSS-Bundle liefert eine komplett ungestylte UI aus (#245).
# js/
css/*.css
!css/contractmanager-main.css
css/*.css.map
dist/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# Claude Code: lokale, ungetrackte Settings (u.a. NC_APPSTORE_TOKEN), siehe .claude/techstack.md
.claude/settings.local.json

# Composer: composer.lock wird committet, die Release-Pruefung vergleicht vendor/ dagegen

# Package lock (keep package-lock.json for reproducible builds)
# package-lock.json

# Test coverage & results
coverage/
test-results/
.phpunit.result.cache
.phpunit.cache/

# Nextcloud
appinfo/signature.json
appinfo/*.crt

# Release artifacts
*.tar.gz
*.zip

# Internal documentation
CLAUDE.md
docs/*
# App-eigene Ergaenzungen zum Design-System der Flotte (nc-design-check)
!docs/design-system.md
sessions/
